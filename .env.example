# IONOS-Postfach für den Versand der Kontaktformular-Anfragen.
# Kopiere diese Datei zu ".env" (lokal) und trage die echten Zugangsdaten ein.
# ".env" ist in .gitignore und wird NIE committet.

# SMTP-Host von IONOS (bei .de-Verträgen meist smtp.ionos.de, bei .com smtp.ionos.com)
IONOS_SMTP_HOST=smtp.ionos.de
IONOS_SMTP_PORT=587

# Die volle Mailbox-Adresse, z.B. info@raumgeschneidert.de
IONOS_SMTP_USER=info@raumgeschneidert.de
# Das Passwort dieses Postfachs
IONOS_SMTP_PASSWORD=

# An welche Adresse die Formular-Anfragen zugestellt werden (Standard: IONOS_SMTP_USER)
CONTACT_TO_EMAIL=info@raumgeschneidert.de
